# Copie para .env e troque TODOS os valores. O arquivo .env não vai para o Git.
# Valores abaixo são fictícios.

# Superusuário do contêiner (só para administração local e para a migração 0001)
POSTGRES_PASSWORD=trocar-senha-superusuario

# Papel que executa as migrações (dono do banco safetycar)
SAFETYCAR_MIGRATOR_PASSWORD=trocar-senha-migrator

# Papel da aplicação (privilégio mínimo, sem DDL)
SAFETYCAR_APP_PASSWORD=trocar-senha-app

# Porta publicada no computador (somente 127.0.0.1)
DB_PORTA=5432

# --- Keycloak (desenvolvimento) ---
# Porta publicada no computador (somente 127.0.0.1)
KEYCLOAK_PORTA=8080
# Senha do banco próprio do Keycloak (contêiner keycloak-db)
KEYCLOAK_DB_PASSWORD=trocar-senha-keycloak-db
# Administrador do console (realm master). Só é criado na primeira subida.
KEYCLOAK_ADMIN_USUARIO=admin-local
KEYCLOAK_ADMIN_SENHA=trocar-senha-admin-keycloak

# --- API (apps/api) ---
# Interface e porta HTTP (só 127.0.0.1 em desenvolvimento)
API_HOST=127.0.0.1
API_PORTA=3000
# fatal, error, warn, info, debug, trace ou silent
API_LOG_NIVEL=info
# Conexão com o banco: SEMPRE o safetycar_app (a API recusa safetycar_migrator e postgres)
API_DB_HOST=127.0.0.1
API_DB_PORTA=5432
API_DB_NOME=safetycar
API_DB_USUARIO=safetycar_app
# Mesmo valor de SAFETYCAR_APP_PASSWORD
API_DB_SENHA=trocar-senha-app
# Realm do Keycloak cujos tokens a API aceita (igual ao "iss" dos tokens; ver docs/KEYCLOAK.md)
KEYCLOAK_ISSUER=http://localhost:8080/realms/safetycar-dev
# Audiência exigida no token de acesso (mapeador audiencia-safetycar-api do client safetycar-web)
KEYCLOAK_AUDIENCE=safetycar-api
