# Copie para .env e troque TODOS os valores. O arquivo .env não vai para o Git.
# Valores abaixo são fictícios.
# As senhas dos papéis do banco só valem na criação do volume. Se mudar alguma depois:
#   bash db/scripts/criar_papeis.sh --verificar     (ok ou FALHOU por papel)
#   bash db/scripts/criar_papeis.sh --sincronizar   (alinha os papéis com este arquivo)

# Superusuário do contêiner (só para administração local e para a migração 0001)
POSTGRES_PASSWORD=trocar-senha-superusuario

# Papel que executa as migrações (dono do banco safetycar)
SAFETYCAR_MIGRATOR_PASSWORD=trocar-senha-migrator

# Papel da aplicação (privilégio mínimo, sem DDL)
SAFETYCAR_APP_PASSWORD=trocar-senha-app

# Papel da Central para ações sensíveis (permissões e aprovações; migração 0014).
# Usado só pelo backend da Central, num pool de conexão separado do app. Em volume já
# existente, crie o papel com: bash db/scripts/criar_papeis.sh
SAFETYCAR_CENTRAL_PASSWORD=trocar-senha-central

# Porta publicada no computador (somente 127.0.0.1)
DB_PORTA=5432

# --- Keycloak (desenvolvimento) ---
# Porta publicada no computador (somente 127.0.0.1). Em desenvolvimento usamos 8180 (a 8080
# costuma estar reservada pelo Windows: netsh interface ipv4 show excludedportrange protocol=tcp).
# Ao mudar, atualize também KEYCLOAK_ISSUER e VITE_KEYCLOAK_URL abaixo (o Node e o Vite não
# expandem ${...} no .env).
KEYCLOAK_PORTA=8180
# Senha do banco próprio do Keycloak (contêiner keycloak-db)
KEYCLOAK_DB_PASSWORD=trocar-senha-keycloak-db
# Administrador do console (realm master). Só é criado na primeira subida.
KEYCLOAK_ADMIN_USUARIO=admin-local
KEYCLOAK_ADMIN_SENHA=trocar-senha-admin-keycloak

# --- API (apps/api) ---
# Interface e porta HTTP (só 127.0.0.1 em desenvolvimento)
API_HOST=127.0.0.1
API_PORTA=3000
# fatal, error, warn, info, debug, trace ou silent
API_LOG_NIVEL=info
# Conexão com o banco: SEMPRE o safetycar_app (a API recusa safetycar_migrator e postgres)
API_DB_HOST=127.0.0.1
API_DB_PORTA=5432
API_DB_NOME=safetycar
API_DB_USUARIO=safetycar_app
# Mesmo valor de SAFETYCAR_APP_PASSWORD
API_DB_SENHA=trocar-senha-app
# Realm do Keycloak cujos tokens a API aceita (igual ao "iss" dos tokens; ver docs/KEYCLOAK.md)
# A porta deve ser a mesma de KEYCLOAK_PORTA.
KEYCLOAK_ISSUER=http://localhost:8180/realms/safetycar-dev
# Audiência exigida no token de acesso (mapeador audiencia-safetycar-api do client safetycar-web)
KEYCLOAK_AUDIENCE=safetycar-api
# Client do frontend: o "azp" do token de acesso precisa ser este
KEYCLOAK_CLIENT_ID=safetycar-web

# --- API da Central (/central; pool próprio no mesmo host, porta e banco do app) ---
# SEMPRE o safetycar_central (a API recusa qualquer outro papel neste pool)
API_CENTRAL_DB_USUARIO=safetycar_central
# Mesmo valor de SAFETYCAR_CENTRAL_PASSWORD. Obrigatória: sem ela a API não sobe.
API_CENTRAL_DB_SENHA=
# Client da Central no Keycloak: o "azp" dos tokens aceitos em /central (diferente do app)
KEYCLOAK_CENTRAL_CLIENT_ID=safetycar-central
# Valor exato do "acr" de nível 2 (senha + OTP); qualquer outro é recusado.
# Provisório: confirmado com token real na etapa do realm (docs/KEYCLOAK.md).
KEYCLOAK_CENTRAL_ACR=2

# --- Frontend (apps/web) ---
# Atenção: variáveis VITE_* vão para o código do navegador. NUNCA coloque segredo nelas.
# Base das chamadas à API (padrão /api, que passa pelo proxy do Vite em desenvolvimento)
VITE_API_BASE=/api
# Destino do proxy /api do servidor de desenvolvimento do Vite (só na configuração, não vai ao navegador)
API_URL_DEV=http://127.0.0.1:3000
# Keycloak visto pelo navegador (client público com PKCE: não existe segredo de cliente).
# URL sem /realms, com a mesma porta de KEYCLOAK_PORTA.
VITE_KEYCLOAK_URL=http://localhost:8180
VITE_KEYCLOAK_REALM=safetycar-dev
VITE_KEYCLOAK_CLIENT_ID=safetycar-web
# "true" liga o link "Criar conta" (exige o cadastro habilitado no realm; hoje está desligado)
VITE_CADASTRO_HABILITADO=false
