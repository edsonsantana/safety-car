{
  "name": "@safetycar/api",
  "version": "0.0.0",
  "private": true,
  "description": "API do Safety Car",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env src/servidor.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/servidor.js",
    "test": "node --test \"test/unit/**/*.test.ts\"",
    "test:integracao": "node --env-file-if-exists=../../.env --test --test-concurrency=1 \"test/integracao/**/*.test.ts\"",
    "lint": "tsc --noEmit && eslint . && prettier --check .",
    "formatar": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  }
}
